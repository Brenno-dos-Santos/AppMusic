<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMusic.Views.InitialPage"
              Shell.NavBarIsVisible="False">

    <ScrollView>
    <VerticalStackLayout BackgroundColor="#35BED1">
        <Image Source="girl.png" Margin="0,70,0,0"></Image>

        <Border 
            BackgroundColor="Black" HeightRequest="400"
            Stroke="Black" StrokeThickness="3">            
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="40,30,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Margin="32">

                <Label FontFamily="DidactGothic" FontSize="30" VerticalOptions="Start" HorizontalOptions="Center" Padding="10" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="From the " TextColor="White"/>
                            <Span Text="latest " TextColor="#76D7E6"/>
                            <Span Text="to the " TextColor="White"/>
                            <Span Text="greatest " TextColor="#76D7E6"/>
                            <Span Text="hits, play your favorite tracks on " TextColor="White"/>
                            <Span Text="musicium " TextColor="#76D7E6"/>
                            <Span Text="now!" TextColor="White"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Border BackgroundColor="#76D7E6"
                  HeightRequest="10"
                  WidthRequest="120"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Margin="0,10,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="7.5"/>
                    </Border.StrokeShape>
                </Border>


                <Button
        Text="Get Started"
        BackgroundColor="#35BED1"
        TextColor="White"
        FontSize="20"
              FontFamily="Mulish"
        CornerRadius="20"
        HeightRequest="50"
        WidthRequest="310"
        HorizontalOptions="Center"
        Margin="0,20,0,0"
        Clicked="Button_Clicked" />
                
                
                <HorizontalStackLayout HorizontalOptions="Center" Padding="0,30,0,0">
                    <ImageButton Source="vector3" Padding="20"/>
                <ImageButton Source="vector1" Padding="20"/>
                <ImageButton Source="vector2" Padding="20"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>





    </VerticalStackLayout>
    </ScrollView>
</ContentPage>