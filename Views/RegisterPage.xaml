<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMusic.Views.RegisterPage"
             Background="Black"
             >


    <VerticalStackLayout >
        <Image Source="logo.png"/>
        <Label Text="Let’s get you in" FontSize="44" TextColor="White"
               FontFamily="DidactGothic" HorizontalOptions="Center" Margin="0,20,0,0"/>
        <Button ImageSource="google.png"
              Text="Continue with Google"
              BackgroundColor="#1E1E1E"
              TextColor="White"
              FontSize="20"
              FontFamily="Mulish"
              HeightRequest="50"
              WidthRequest="310"
              HorizontalOptions="Center"
              Margin="0,50,0,0"
              BorderColor="White" BorderWidth="0.2"  />


        <Button ImageSource="fb.png"
           Text="Continue with Facebook"
           BackgroundColor="#1E1E1E"
           TextColor="White"
           FontSize="20"
           FontFamily="Mulish"
           HeightRequest="50"
           WidthRequest="310"
           HorizontalOptions="Center"
           Margin="0,15,0,0"
           BorderColor="White" BorderWidth="0.2"/>
        
        <Button ImageSource="apple.png"
           Text="Continue with Apple"
           BackgroundColor="#1E1E1E"
           TextColor="White"
           FontSize="20"
           FontFamily="Mulish"
           HeightRequest="50"
           WidthRequest="310"
           HorizontalOptions="Center"
           Margin="0,15,0,0"
           BorderColor="White" BorderWidth="0.2"
              />

        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,20,0,0">
            <Line X1="0" Y1="0" X2="137" Y2="0" Stroke="White" StrokeThickness="1" VerticalOptions="Center"/>
            <Label Text=" or " TextColor="White"></Label>
            <Line X1="0" Y1="0" X2="137" Y2="0" Stroke="White" StrokeThickness="1" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Button
        Text="Log in with a password"
        BackgroundColor="#35BED1"
        TextColor="White"
        FontSize="20"
        FontFamily="Mulish"
        CornerRadius="20"
        HeightRequest="50"
        WidthRequest="310"
        HorizontalOptions="Center"
        Margin="0,30,0,0"
        Clicked="Login" />
        
        
        <Label FontFamily="DidactGothic" FontSize="16" VerticalOptions="Start" HorizontalOptions="Center" Padding="20" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Don’t have an account? " TextColor="White"/>
                    <Span Text="Sign up" TextColor="#76D7E6"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

    </VerticalStackLayout>
</ContentPage>