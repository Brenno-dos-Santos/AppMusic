<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMusic.Views.LoginPage"
             BackgroundColor="Black">
    <VerticalStackLayout>
        <Image Source="logo.png" WidthRequest="325" HeightRequest="275"/>
        <Label Text="Login to your account" FontSize="32" TextColor="White"
        FontFamily="DidactGothic" HorizontalOptions="Center" Margin="0,20,0,0"/>

        <Border HeightRequest="50" BackgroundColor="#DBE7E8" Stroke ="Transparent" Padding="10,0,10,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Entry Placeholder="Email" BackgroundColor="#DBE7E8" TextColor="Black" FontSize="20" FontFamily="Mulish"
                 />
        </Border>
    </VerticalStackLayout>
</ContentPage>